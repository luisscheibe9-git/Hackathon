# Haven CSI node: classic ESP32 (ESP32-WROOM-32U dev boards with an external U.FL antenna)
CONFIG_IDF_TARGET="esp32"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Channel State Information must be compiled into the Wi-Fi driver
CONFIG_ESP_WIFI_CSI_ENABLED=y

# Serial console: 921600 baud carries the optional serial CSI stream (same rate as esp-csi examples)
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Bigger Wi-Fi / lwIP pools: CSI streaming at ~100 frames/s exhausts the defaults (ENOMEM on sendto)
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=y
